# AWS Credentials and SageMaker Execution Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Storage
S3_BUCKET=your-criteo-uplift-bucket-name

# IAM Role for SageMaker Processing
SAGEMAKER_ROLE_ARN=arn:aws:iam::your-account-id:role/service-role/AmazonSageMaker-ExecutionRole
